---
import { Image } from "astro:assets";

import bulldog from "@/assets/images/bulldog.png";
import contactDog from "@/assets/images/perro-para-envio.jpg";
import emblem from "@/assets/images/kache-emblem.png";
import hero from "@/assets/images/hero-mascotas.jpg";
import laura from "@/assets/images/laura-max.jpg";
import mati from "@/assets/images/mati-torres.jpg";
import presentacion from "@/assets/presentacion.mp4";
import rudol from "@/assets/images/rudol.jpg";
import Icon from "@/components/Icon.astro";
import LiveBoxes from "@/components/LiveBoxes.astro";
import LiveRoutes from "@/components/LiveRoutes.astro";
import TransportGallery from "@/components/TransportGallery.astro";
import {
  importantInfo,
  pricingNotes,
  steps,
  testimonials,
} from "@/config/content";
import { site } from "@/config/site";
import Base from "@/layouts/Base.astro";
import { fetchBoxCatalogSafe } from "@/lib/catalog";
import { fetchPublicRoutesSafe } from "@/lib/routes";

import "@/styles/home.css";

const [routes, boxes] = await Promise.all([
  fetchPublicRoutesSafe(),
  fetchBoxCatalogSafe(),
]);
const portraits = [rudol, mati, laura];
---

<Base>
  <div class="kache-home">
    <section class="home-hero min-h-[100svh]" aria-labelledby="home-title">
      <div class="container-page home-hero-inner">
        <div class="home-hero-copy">
          <Image
            src={emblem}
            alt=""
            widths={[240, 400]}
            sizes="240px"
            class="home-emblem"
            loading="eager"
          />
          <div class="home-hero-title">
            <p class="home-phone">CONTACTE AL <br> 658 60 49 33 con STELLA</p>
            <h1 id="home-title">Kache Envíos</h1>
            <p class="home-tagline">Transporte de mascotas</p>
          </div>
          <div class="home-btn-group">
            <a href={site.phone.href} class="btn btn-primary btn-hero gap-3"
              >Reserva tu plaza
            </a>
            <a href={site.phone.href} class="btn btn-primary btn-phone gap-3"
              >
              <img src="https://proyectosfba.es/imagenes/telefon_%20blanco.png" alt="" width="20" class="text-white">
            </a>
          </div>
          <ul class="home-social" aria-label="Redes sociales">
            {
              site.social.map((network) => (
                <li>
                  <a
                    href={network.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={network.name}
                  >
                    <Icon name={network.icon} class="size-6" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <Image
          src={hero}
          alt="Mascotas viajando con Kache Envíos"
          widths={[400, 640, 800]}
          sizes="(min-width: 981px) 490px, 80vw"
          class="home-hero-photo"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </section>

    <section
      id="servicio"
      class="home-service container-page"
      aria-labelledby="servicio-title"
    >
      <video
        class="home-video"
        src={presentacion}
        controls
        playsinline
        preload="metadata"
        aria-label="Vídeo de presentación de Kache Envíos"></video>
      <h2 id="servicio-title" class="home-heading">
        Disponemos de Servicio<br />PUERTA A PUERTA OPCIONAL
      </h2>
      <p class="home-subheading">Consulta nuestras tarifas y precios</p>
      <a href={site.phone.href} class="btn btn-primary mt-8"
        >¡Llámanos! {site.phone.display}</a
      >
      <div class="home-note">
        <h3>
          Kache Envíos, empresa especializada en el transporte de mascotas.
        </h3>
        <p>
          Nuestro transporte de mascotas es un servicio en el que su bienestar
          es lo más importante. Nos aseguramos de que cada mascota sea tratada
          con los cuidados que necesita, brindándoles un viaje seguro y cómodo.
          Nuestro equipo de profesionales está capacitado para manejar cualquier
          situación, garantizando que sus amigos peludos reciban la atención
          adecuada en todo momento durante el transporte de tu mascota.
        </p>
        <p>
          Nuestro equipo de profesionales altamente capacitados se encarga de
          cada detalle del viaje, desde la recogida hasta la entrega. Utilizamos
          vehículos especialmente adaptados para el transporte de mascotas,
          equipados con sistemas de control de temperatura y ventilación para
          mantener un ambiente óptimo durante todo el trayecto.
        </p>
      </div>
    </section>

    <section class="home-how container-page" aria-labelledby="como-title">
      <h2 id="como-title" class="home-heading">¿Cómo lo hacemos?</h2>
      <ol class="home-steps">
        {
          steps.map((step) => (
            <li>
              <span class="home-step-icon" aria-hidden="true">
                {step.glyph}
              </span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
      <a href={site.phone.href} class="btn btn-primary"
        >¿Alguna duda? {site.phone.display}</a
      >
    </section>

    <TransportGallery />

    <section id="rutas" class="home-routes" aria-labelledby="rutas-title">
      <div class="container-page">
        <h2 id="rutas-title" class="home-heading">Próximas rutas</h2>
        <LiveRoutes
          routes={routes}
          limit={3}
          appearance="classic"
          class="home-route-list"
        />
        <a href="/rutas" class="home-all-routes"
          >Ver todas las rutas y puntos de encuentro <Icon
            name="arrowRight"
            class="size-4"
          /></a
        >
        <div class="home-route-info">
          <h3>INFORMAMOS DE LAS RUTAS MENSUALES<br />¡CONTÁCTANOS!</h3>
          <p>
            Si has adquirido más de un cachorro en el mismo bóxer, o prefiere
            origen y / o destino en otro punto DIFERENTE a los nuestros, el
            precio del transporte variará según el número de mascotas, y / o km,
            para ello contacta con nosotros.
          </p>
          <p>
            <span class="text-[#e02b20]">CONTACTAR CON NOSOTROS PARA:</span><br />
            -Contratación de aves, hurones o exóticos.<br />
            -Si la mascota pesa más de 40 kgs.<br />
            ¡¡¡PARA LA CONTRATACIÓN DE LA RUTA CONTACTE CON NOSOTROS!!!
          </p>
          <a href={site.phone.href} class="btn btn-primary"
            >Llama al {site.phone.display}</a
          >
        </div>
      </div>
    </section>

    <section class="home-delivery" aria-labelledby="entrega-title">
      <div class="container-page home-delivery-inner">
        <Image
          src={bulldog}
          alt="Bulldog con su correa, preparado para el viaje"
          widths={[360, 600, 800]}
          sizes="480px, 80vw"
          class="home-delivery-dog"
        />
        <div class=" w-[100%] md:max-w-160 md:ml-10">
          <h2 id="entrega-title" class="home-heading">
            Entrega en<br />toda España
          </h2>
          <p class="home-subheading">
            ¡Échale un vistazo a<br />nuestras tarifas!
          </p>
          <p>
            Elige tu ruta, infórmate sobre precios y puntos de encuentro en los
            que paramos CONTACTANDO AL {site.phone.display}; así como si decides
            contratar un servicio exclusivo por si no puedes desplazarte.
            <strong
              >¡Somos la elección ideal para el transporte de mascotas!</strong
            >
          </p>
          <p>
            Todo nuestro equipo de profesionales trabaja para tu tranquilidad y
            el bienestar de tu mascota, cada mascota es monitoreada
            constantemente para asegurarse de que esté cómoda y libre de estrés.
          </p>
          <p>
            *(La contratación del transporte puerta a puerta conlleva otro
            coste, el cual depende de la distancia, kms, tiempo, etc.)*
          </p>
          <a href={site.phone.href} class="btn btn-primary"
            >¿Alguna duda? {site.phone.display}</a
          >
        </div>
      </div>
    </section>

    <section class="home-reviews" aria-labelledby="opiniones-title">
      <div class="container-page">
        <h2 id="opiniones-title" class="home-heading">Dueños contentos</h2>
        <div class="home-review-gallery" data-gallery>
          <ul
            class="home-testimonials"
            data-gallery-track
            tabindex="0"
            aria-label="Opiniones de nuestros clientes"
          >
            {
              testimonials.map((item, index) => (
                <li>
                  <Image
                    src={portraits[index]}
                    alt=""
                    widths={[80, 160]}
                    sizes="80px"
                    class="home-review-photo"
                  />
                  <p class="home-review-stars" aria-label="5 estrellas">
                    ☆☆☆☆☆
                  </p>
                  <details class="home-review-text">
                    <summary>
                      <span>{item.text.slice(0, 100)}…</span>
                      <span class="home-review-more">Leer más</span>
                    </summary>
                    <blockquote>“{item.text}”</blockquote>
                  </details>
                  <p class="home-review-name">{item.name}</p>
                </li>
              ))
            } 
          </ul>
          <button
            type="button"
            data-gallery-prev
            aria-label="Opiniones anteriores"
            class="home-review-arrow home-review-prev"
            ><Icon name="arrowRight" class="size-7 rotate-180" /></button
          >
          <button
            type="button"
            data-gallery-next
            aria-label="Opiniones siguientes"
            class="home-review-arrow home-review-next"
            ><Icon name="arrowRight" class="size-7" /></button
          >
        </div>
        <div class="home-conditions">
          <details>
            <summary>Información importante</summary>
            <ul>{importantInfo.map((item) => <li>{item}</li>)}</ul>
          </details>
          <details id="tarifas">
            <summary>Tarifas</summary>
            <LiveBoxes boxes={boxes} class="py-6" />
            <ul>{pricingNotes.map((item) => <li>{item}</li>)}</ul>
            <a href="/tarifas" class="btn btn-primary"
              >Ver tarifas y condiciones</a
            >
          </details>
        </div>
      </div>
    </section>

    <section
      id="contacto"
      class="home-contact"
      aria-labelledby="contacto-title"
    >
      <div class="container-page">
        <h2 id="contacto-title" class="home-heading">Contacta con nosotros</h2>
        <div class="home-contact-inner">
          <Image
            src={contactDog}
            alt="Perro en su transportín, listo para salir"
            widths={[400, 640]}
            sizes="(min-width: 768px) 480px, 90vw"
            class="home-contact-photo"
          />
          <div class="home-contact-copy">
            <Image
              src={emblem}
              alt="Kache Envíos"
              widths={[200, 320]}
              sizes="180px"
              class="home-contact-emblem"
            />
            <div>
              <h3>U b i c a c i ó n</h3>
              <p>{site.location}</p>
            </div>
            <div>
              <h3>T e l é f o n o</h3>
              <a href={site.phone.href}>{site.phone.display}</a>
            </div>
            <div>
              <h3>E m a i l</h3>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <a href="#top" class="back-to-top" aria-label="Volver arriba">
    <Icon name="arrowRight" class="size-6 -rotate-90" />
  </a>
</Base>
