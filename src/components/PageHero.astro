---
type Props = { title: string; text?: string };

const { title, text } = Astro.props;
---

<section class="relative overflow-hidden bg-cream">
  <div
    class="pointer-events-none absolute -top-24 -right-24 size-80 rounded-full bg-brand/15 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div class="container-page relative py-14 sm:py-20">
    <h1 class="max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">
      {title}
    </h1>
    {text && <p class="mt-4 max-w-2xl text-lg text-ink-soft">{text}</p>}
    <slot />
  </div>
</section>
