---
import { signature, todayInSpain } from "@/lib/format";
import { renderRouteList, renderRoutesNotice } from "@/lib/render";
import type { RouteCardOptions } from "@/lib/render";
import { upcomingRoutes, type PublicRoute } from "@/lib/routes";
import { isSupabaseConfigured } from "@/lib/supabase";

type Props = {
  /** `null` when the build could not reach Supabase: the browser fills it in. */
  routes: PublicRoute[] | null;
  limit?: number;
  compact?: boolean;
  appearance?: RouteCardOptions["appearance"];
  class?: string;
};

const {
  routes,
  limit,
  compact = false,
  appearance = "default",
  class: className = "",
} = Astro.props;
const today = todayInSpain();
const visible = routes ? upcomingRoutes(routes, today).slice(0, limit) : [];
const listHtml = renderRouteList(visible, { today, compact, appearance });
const noticeHtml = routes && !visible.length
  ? renderRoutesNotice("empty")
  : !routes && !isSupabaseConfigured ? renderRoutesNotice("error") : "";
const loading = !routes && isSupabaseConfigured;
---

<div
  class={className}
  data-live-routes
  data-limit={limit}
  data-compact={String(compact)}
  data-appearance={appearance}
  aria-busy={loading ? "true" : undefined}
  aria-live="polite"
>
  <ul
    class="grid gap-5 md:grid-cols-2 lg:grid-cols-3"
    data-routes-list
    data-signature={routes ? signature(listHtml) : undefined}
    set:html={listHtml}
  />
  <div data-routes-notice set:html={noticeHtml} />
  {
    loading && (
      <div
        class="grid gap-5 md:grid-cols-2 lg:grid-cols-3"
        data-routes-skeleton
        aria-hidden="true"
      >
        <div class="skeleton h-72" />
        <div class="skeleton h-72" />
        <div class="skeleton hidden h-72 lg:block" />
      </div>
    )
  }
</div>

<style>
  [data-live-routes]:not([aria-busy]) [data-routes-skeleton] {
    display: none;
  }
</style>

<script>
  import "@/scripts/live-data";
  import "@/scripts/route-maps";
</script>
