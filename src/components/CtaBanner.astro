---
import { appLinks, site } from '@/config/site'

import Icon from './Icon.astro'
---

<section class="container-page py-16 sm:py-20">
  <div class="relative overflow-hidden rounded-[2rem] bg-ink px-6 py-12 text-white sm:px-12 sm:py-16">
    <div
      class="pointer-events-none absolute -right-20 -bottom-28 size-96 rounded-full bg-brand/40 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="relative grid items-center gap-8 lg:grid-cols-[1.5fr_1fr]">
      <div>
        <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">
          ¿Listo para el viaje de tu mascota?
        </h2>
        <p class="mt-3 max-w-xl text-white/75">
          Solicita la plaza online en dos minutos. Desde tu panel podrás seguir el estado de la
          solicitud, tus transportes y tus mascotas.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 lg:justify-end">
        <a href={appLinks.requestTransport()} class="btn btn-primary">
          Solicitar transporte <Icon name="arrowRight" class="size-4" />
        </a>
        <a href={site.phone.href} class="btn btn-ghost-light">
          <Icon name="phone" class="size-4" />
          {site.phone.display}
        </a>
      </div>
    </div>
  </div>
</section>
