---
import { Image } from "astro:assets";
import originalLogo from "@/assets/images/header-original.png";
import { appLinks, navigation, site } from "@/config/site";

import Icon from "./Icon.astro";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) => !href.includes("#") && href === path;
---

<header
  class="site-header sticky top-0 z-40 bg-black text-white"
  data-site-header
>
  <a
    href="#contenido"
    class="sr-only z-50 rounded-full bg-ink px-4 py-2 text-sm font-bold text-white focus:not-sr-only focus:absolute focus:top-3 focus:left-3"
  >
    Saltar al contenido
  </a>
  <div class="site-header-inner flex items-center justify-between gap-4">
    <a
      href="/"
      class="flex shrink-0 items-center gap-3"
      aria-label={`${site.name}, inicio`}
    >
      <Image
        src={originalLogo}
        alt=""
        widths={[220, 440]}
        sizes="220px"
        class="site-header-logo"
      />
    </a>

    <nav aria-label="Principal" class="site-navigation hidden lg:block">
      <ul class="flex items-center gap-5">
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
                class="py-2 text-white/85 hover:text-white aria-[current=page]:text-[#d3d3d3]"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={appLinks.clientPortal}
        class="site-portal"
        aria-label="Mi panel de cliente"
      >
        <Icon name="user" class="size-5" />
      </a>
      <button
        type="button"
        class="btn btn-ghost-light size-11 px-0 lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Abrir menú"
        data-menu-toggle
      >
        <Icon name="menu" class="size-5" />
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="border-t border-white/15 bg-black lg:hidden"
    hidden
    data-menu
  >
    <nav aria-label="Móvil" class="container-page grid gap-1 py-4">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
            class="rounded-xl px-3 py-3 text-base font-semibold hover:bg-white/10 aria-[current=page]:underline"
          >
            {item.label}
          </a>
        ))
      }
      <div class="mt-3 grid gap-2 sm:grid-cols-2">
        <a href={appLinks.requestTransport()} class="btn btn-primary"
          >Reservar transporte</a
        >
        <a href={appLinks.clientPortal} class="btn btn-ghost-light">
          <Icon name="user" class="size-4" /> Mi panel de cliente
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header-inner {
    width: 80%;
    max-width: 1080px;
    min-height: 103px;
    margin-inline: auto;
  }
  .site-header-logo {
    width: auto;
    height: 95px;
  }
  .site-navigation {
    margin-left: auto;
    font:
      700 20px/1 var(--font-amatic),
      cursive;
  }
  .site-portal {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    color: #8fbabf;
  }
  .site-header[data-scrolled] {
    background: #fff;
    color: #444;
    box-shadow: 0 0 7px #0002;
  }
  .site-header[data-scrolled] .site-navigation a {
    color: #444;
  }
  .site-header[data-scrolled] .site-header-inner {
    min-height: 54px;
  }
  .site-header[data-scrolled] .site-header-logo {
    height: 48px;
  }
  .site-header[data-scrolled] [data-menu-toggle] {
    color: #444;
    border-color: #ddd;
  }
  @media (max-width: 1023px) {
    .site-header-inner {
      min-height: 80px;
    }
    .site-header-logo {
      height: 70px;
      max-width: 50vw;
      object-fit: contain;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle =
    document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  };

  toggle?.addEventListener("click", () => setOpen(Boolean(menu?.hidden)));
  menu?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu && !menu.hidden) {
      setOpen(false);
      toggle?.focus();
    }
  });
  window
    .matchMedia("(min-width: 64rem)")
    .addEventListener("change", () => setOpen(false));

  const onScroll = () =>
    header?.toggleAttribute("data-scrolled", window.scrollY > 8);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
