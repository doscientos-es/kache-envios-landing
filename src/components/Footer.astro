---
import { Image } from "astro:assets";
import emblem from "@/assets/images/kache-emblem.png";
import { appLinks, site } from "@/config/site";
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <a href="/" aria-label={`${site.name}, inicio`}>
      <Image
        src={emblem}
        alt={site.name}
        widths={[216, 432]}
        sizes="216px"
        class="site-footer-logo"
      />
    </a>
    <nav aria-label="Pie de página" class="text-center">
      <a href="/#contacto">Contacto</a> · <a href={appLinks.clientPortal}
        >Mi panel</a
      > · <a href="/sitemap-index.xml">Mapa del Sitio</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 3px inset #8fbabf;
    background: #000;
    color: #fff;
  }
  .site-footer-inner {
    width: 80%;
    max-width: 1080px;
    margin-inline: auto;
    padding: 15px 0 18px;
  }
  .site-footer-logo {
    width: 216px;
    height: auto;
    margin-inline: auto;
  }
  nav {
    padding: 22px 25px 9px;
    font: 700 19px/1.8 var(--font-display);
  }
  nav a:hover {
    text-decoration: underline;
  }
  @media (max-width: 767px) {
    nav {
      padding-inline: 0;
      font-size: 16px;
      text-align: center;
    }
  }
</style>
